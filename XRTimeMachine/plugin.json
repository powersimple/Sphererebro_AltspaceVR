  "platform": "altspace",
  "sources": ["src/xrtm-core.js", "src/adapter-altspace.js"],
  "dist": "dist/xrtm.js",
  "target": "../Assets/WebRoot/script.js",
  "markers": {
    "begin": "// >>> XR Time Machine recorder",
    "end": "// <<< XR Time Machine recorder",
    "configBegin": "// >>> XR Time Machine config",
    "configEnd": "// <<< XR Time Machine config"
  }
}
